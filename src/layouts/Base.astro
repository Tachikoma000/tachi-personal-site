---
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/300-italic.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/500.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/zen-kaku-gothic-new/300.css';
import '@fontsource/zen-kaku-gothic-new/400.css';
import '../styles/global.css';
import Sky from '../components/Sky.astro';
import Washi from '../components/Washi.astro';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  ogTitle?: string; // share-card override; defaults to title
  ogDescription?: string; // share-card override; defaults to description
  /** The light this page opens in (E). A visitor's own choice still wins. */
  hour?: 'dawn' | 'morning' | 'midday' | 'dusk' | 'bleue' | 'night';
}
const { title, description, ogType = 'website', ogTitle = title, ogDescription = description, hour } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(withBase('/og-card.png'), Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title="tachi" href={withBase('/rss.xml')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
  </head>
  <body data-hour={hour ?? 'midday'} data-page-hour={hour}>
    <script is:inline>
      (function () {
        var VALID = ['dawn', 'morning', 'midday', 'dusk', 'bleue', 'night'];
        var chosen = null;
        try {
          chosen = sessionStorage.getItem('tachi-hour');
        } catch (e) {}
        var h;
        if (VALID.indexOf(chosen) !== -1) {
          // A visitor who has set the hour keeps it everywhere. A poem may
          // suggest its light, but only to someone who has not chosen.
          h = chosen;
        } else {
          var pageHour = document.body.getAttribute('data-page-hour');
          if (VALID.indexOf(pageHour) !== -1) {
            h = pageHour;
          } else {
            var n = new Date().getHours();
            h =
              n >= 5 && n < 8 ? 'dawn'
              : n >= 8 && n < 12 ? 'morning'
              : n >= 12 && n < 16 ? 'midday'
              : n >= 16 && n < 19 ? 'dusk'
              : n >= 19 && n < 21 ? 'bleue'
              : 'night';
          }
        }
        document.body.setAttribute('data-hour', h);
      })();
    </script>
    <Sky />
    <Washi />
    <main class="page"><slot /></main>
  </body>
</html>
