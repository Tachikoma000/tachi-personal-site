---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import AuthorNote from '../../components/AuthorNote.astro';
import Epigraph from '../../components/Epigraph.astro';
import PoemBody from '../../components/PoemBody.astro';
import NextPoem from '../../components/NextPoem.astro';
import { familyOf } from '../../lib/families';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const poems = await getCollection('poems');
  const byFamily = {
    breath: poems.filter((p) => p.data.family === 'breath').sort((a, b) => a.data.order - b.data.order),
    telling: poems.filter((p) => p.data.family === 'telling').sort((a, b) => a.data.order - b.data.order),
  };
  return poems.map((poem) => {
    // Next in this family; at a family's end, cross to the head of the other,
    // so the collection reads as one loop with no dead ends.
    const siblings = byFamily[poem.data.family];
    const here = siblings.findIndex((p) => p.id === poem.id);
    const other = byFamily[poem.data.family === 'breath' ? 'telling' : 'breath'];
    const next = siblings[here + 1] ?? other[0];
    return { params: { slug: poem.id }, props: { poem, next } };
  });
}
const { poem, next } = Astro.props;
const family = familyOf(poem.data.family);
const note = await getEntry('poemNotes', poem.id);
const NoteContent = note ? (await render(note)).Content : null;
---
<Base title={`${poem.data.title} — tachi`} description={poem.data.excerpt} ogType="article" hour={poem.data.hour}>
  <section class="view">
    <TopBar active="poems" />
    <a class="back-link" href={withBase(`/poems/${family.slug}/`)}>← {family.name}</a>
    <SectionHeading title={poem.data.title} note={poem.data.sub} />
    {poem.data.epigraph && (
      <Epigraph attribution={poem.data.epigraphSource} style="max-width:40ch;margin:0 0 2.9rem">
        {poem.data.epigraph.trimEnd().split('\n').map((line, i) => (
          <Fragment>{i > 0 && <br />}{line}</Fragment>
        ))}
      </Epigraph>
    )}
    {NoteContent && (
      <AuthorNote label="a note, before we begin" skipLabel="to the poem" bridgeLabel="the poem" target="the-poem">
        <NoteContent />
        <p>With love and gratitude,<br />Tachi</p>
      </AuthorNote>
    )}
    <PoemBody body={poem.body ?? ''} tailpiece={poem.data.tailpiece ?? poem.data.illustration} id="the-poem" family={poem.data.family} />
    {next && next.id !== poem.id && <NextPoem poem={next} />}
  </section>
</Base>
