---
// Poems index — "two doors" (design 7b, supersedes the three-preview index).
// The index no longer previews poems: each family is one door stating what it
// is, whispering its first few titles, and carrying its total on the baseline.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { FAMILIES } from '../../lib/families';
import { numberToWords } from '../../lib/numberToWords';
import { withBase } from '../../lib/url';

const WHISPERED = 5; // titles shown inside each door before "and N others"

const poems = await getCollection('poems');
const doors = FAMILIES.map((fam) => {
  const all = poems
    .filter((p) => p.data.family === fam.key)
    .sort((a, b) => a.data.order - b.data.order);
  const shown = all.slice(0, WHISPERED).map((p) => p.data.title);
  const rest = all.length - shown.length;
  const parts =
    rest > 0
      ? [...shown, `and ${numberToWords(rest)} ${rest === 1 ? 'other' : 'others'}`]
      : shown;
  // Non-breaking space before the separator, so a " · " can never wrap to the
  // start of a line and read as a bullet. Titles print verbatim — a poem's
  // title is authored text, not UI copy.
  const whisper = parts.join(' · ');
  return { fam, whisper, count: numberToWords(all.length), total: all.length };
});
---
<Base title="poems — tachi" description="praise-songs & lyrics — poems by tachi">
  <section class="view">
    <TopBar active="poems" />
    <SectionHeading title="Poems" note="praise-songs & lyrics" />
    {doors.map(({ fam, whisper, count, total }) => (
      <a
        class="door"
        href={withBase(`/poems/${fam.slug}/`)}
        aria-label={`${fam.name} — ${count} poem${total === 1 ? '' : 's'}`}
      >
        <span class="fname">{fam.name}</span>
        <span class="fdesc">{fam.description}</span>
        <span class="inside">{whisper}</span>
        <span class="base">
          <span class="count">{count}</span>
          <span class="fdots" aria-hidden="true"><i></i><i></i><i></i></span>
        </span>
      </a>
    ))}
  </section>
</Base>
