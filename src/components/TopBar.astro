---
import Spot from './Spot.astro';
import HourMark from './HourMark.astro';
import { withBase } from '../lib/url';

interface Props {
  active?: 'poems' | 'writings' | 'books' | 'about';
}
const { active } = Astro.props;
const items = [
  { id: 'poems', label: 'poems', href: '/poems/' },
  { id: 'writings', label: 'writings', href: '/writings/' },
  { id: 'books', label: 'books', href: '/books/' },
  { id: 'about', label: 'about', href: '/about/' },
] as const;
---
<div class="topbar">
  <a class="home-link" href={withBase('/')}>
    <span class="home-mark"><Spot name="bird-creature" size={34} /></span>
    <span class="home-word">home</span>
  </a>
  <div class="topbar-right">
    <nav class="topnav">
      {items.map((it) => (
        <a href={withBase(it.href)} class={active === it.id ? 'here' : undefined}>{it.label}</a>
      ))}
    </nav>
    <HourMark />
  </div>
</div>
