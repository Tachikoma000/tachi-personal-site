---
interface Props {
  label: string;
  target: string;
}
const { label, target } = Astro.props;
---
<a class="beacon" href={`#${target}`} data-target={target} aria-label={`Skip to ${label}`}>{label}</a>

<script>
  const beacon = document.querySelector<HTMLAnchorElement>('.beacon');
  if (beacon) {
    const target = document.getElementById(beacon.dataset.target!);
    if (target) {
      // Explicit scroll: fragment navigation is unreliable under smooth
      // scroll-behavior; the href remains a working anchor without JS.
      beacon.addEventListener('click', (e) => {
        e.preventDefault();
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      });
      if ('IntersectionObserver' in window) {
        // Fade the beacon once the piece genuinely enters the reading zone
        // (top 60% of the viewport); bring it back if the reader scrolls up.
        const io = new IntersectionObserver(
          ([entry]) => beacon.classList.toggle('gone', entry.isIntersecting),
          { rootMargin: '0px 0px -40% 0px' },
        );
        io.observe(target);
      }
    }
  }
</script>
