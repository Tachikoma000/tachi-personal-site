---
import Spot from './Spot.astro';
import { parsePoem, renderLine } from '../lib/poem';

interface Props {
  body: string;
  tailpiece?: string;
  id?: string;
  /** Tellings open their first stanza a little larger on desktop (5e). */
  family?: 'breath' | 'telling';
}
const { body, tailpiece, id, family } = Astro.props;
const stanzas = parsePoem(body);
---
<div class={family === 'telling' ? 'poem poem-telling' : 'poem'} id={id}>
  {stanzas.map((st, si) => {
    const cls = si === 0 ? 'poem-line poem-open' : 'poem-line';
    const lines = st.lines.map((line) => renderLine(line));
    return (
      <>
        {st.italic
          ? <em>{lines.map((html) => <span class={cls} set:html={html} />)}</em>
          : lines.map((html) => <span class={cls} set:html={html} />)}
        <span class="stanza-gap"></span>
      </>
    );
  })}
  <em>— tachi</em>
</div>
{tailpiece && <Spot name={tailpiece} size={72} style="margin:3.2rem auto 0" />}
