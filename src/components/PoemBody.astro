---
import Spot from './Spot.astro';
import { parsePoem, renderLine } from '../lib/poem';

interface Props {
  body: string;
  tailpiece?: string;
  id?: string;
}
const { body, tailpiece, id } = Astro.props;
const stanzas = parsePoem(body);
---
<div class="poem" id={id}>
  {stanzas.map((st) => {
    const lines = st.lines.map((line) => renderLine(line));
    return (
      <>
        {st.italic
          ? <em>{lines.map((html) => <span class="poem-line" set:html={html} />)}</em>
          : lines.map((html) => <span class="poem-line" set:html={html} />)}
        <span class="stanza-gap"></span>
      </>
    );
  })}
  <em>— tachi</em>
</div>
{tailpiece && <Spot name={tailpiece} size={72} style="margin:3.2rem auto 0" />}
