---
// Compact index row (design 4g): title + meta + the poem's own spot
// illustration (44/52px), the whole row a link. Breath rows omit the
// dedication line per spec; telling rows show it (showSub).
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/url';

interface Props {
  poem: CollectionEntry<'poems'>;
  showSub?: boolean;
}
const { poem, showSub = false } = Astro.props;
const { title, sub, illustration, year } = poem.data;
---
<a class="poem-row" href={withBase(`/poems/${poem.id}/`)}>
  <span class="pr-text">
    <span class="pr-title">{title}</span>
    {showSub && sub && <span class="pr-sub">{sub}</span>}
    <span class="pr-meta">{`poem · ${year}`}</span>
  </span>
  <img src={withBase(`/illustrations/${illustration}.svg`)} alt="" />
</a>
